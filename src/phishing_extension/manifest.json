{
  "manifest_version": 3,
  "name": "Phishing Detection System",
  "version": "1.0",
  "description": "Detect phishing websites using CNN models",
  "permissions": ["tabs", "activeTab", "scripting", "notifications"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo1.png"
    }
  },
  
  "icons": {
    "16": "icons/logo1.png"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}